# Copie para .env e preencha. NUNCA commite o .env com valores reais.
#
# JWT_SECRET: chave de assinatura dos tokens JWT (obrigatório).
# Formato exigido pelo JwtUtil: Base64URL (sem padding) de >= 32 bytes.
# Gere uma chave nova e aleatória com:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=

# MySQL 8.4 (usado pelo docker-compose.yml e profile prod)
MYSQL_DATABASE=delivery
MYSQL_USER=delivery
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
